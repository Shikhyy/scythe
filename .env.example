# Scythe 3D Multiplayer — Environment Configuration Example
# Copy to .env.local for local overrides. Never commit secrets.

# Node environment
NODE_ENV=development

# Web client
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GAME_SERVER_WS_URL=ws://localhost:2567

# Authoritative game server
PORT=2567
GAME_SERVER_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL) — for match snapshots, event logs, accounts
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scythe_dev

# Session and authentication secrets (minimum 32 characters in production)
SESSION_SECRET=development_session_secret_change_in_production_min32

# Asset hosting / CDN (optional local fallback uses /public)
NEXT_PUBLIC_ASSET_BASE_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_CINEMATICS=true
NEXT_PUBLIC_ENABLE_AUDIO=true
NEXT_PUBLIC_ENABLE_DEV_OVERLAYS=true
